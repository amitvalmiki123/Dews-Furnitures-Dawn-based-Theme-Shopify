{%- comment -%}
  Dew's Furniture — desktop filter rail (collection.html .filters--rail)
  Sticky accordion of facets (checkbox / swatch / price range) inside a
  facet-filters-form (#FacetFiltersForm) so facets.js keeps working.

  Swatches are shown when Shopify has swatch data (value.swatch) OR when the
  filter is a colour-like filter (label contains colour/finish/fabric/…), with
  the dews-color-hex name map as fallback so "Espresso" etc. still render a
  round colour swatch even when no swatch was configured in Search & Discovery.
{%- endcomment -%}

{%- liquid
  if results.url
    assign results_url = results.url
  else
    assign terms = results.terms | escape
    assign results_url = '?q=' | append: terms
  endif
-%}

{%- if enable_filtering and results.filters.size > 0 -%}
  <facet-filters-form class="facets">
    <form id="FacetFiltersForm" class="facets__form-vertical">
      <div class="filters__head">
        <h2>{{ 'products.facets.filter_button' | t }}</h2>
        <a class="filters__clear" href="{{ results_url }}" data-clear-filters>{{ 'products.facets.clear_all' | t }}</a>
      </div>

      <div id="FacetsWrapperDesktop">
        {%- for filter in results.filters -%}
          {%- liquid
            assign filter_label = filter.label | downcase
            assign has_swatches = false
            if filter_label contains 'color'
              or filter_label contains 'colour'
              or filter_label contains 'finish'
              or filter_label contains 'fabric'
              or filter_label contains 'shade'
              or filter_label contains 'stain'
              or filter_label contains 'upholstery'
              or filter_label contains 'leather'
              assign has_swatches = true
            endif
            if has_swatches == false
              for fv in filter.values
                if fv.swatch.color != blank or fv.swatch.image != blank
                  assign has_swatches = true
                endif
              endfor
            endif
          -%}
          <details
            id="Details-{{ filter.param_name | escape }}-{{ section_id }}"
            class="facet js-filter{% if has_swatches %} facet--swatch{% endif %}"
            data-index="{{ forloop.index }}"
            {% if forloop.first or filter.active_values.size > 0 %}open{% endif %}
          >
            <summary class="facet__q facets__summary" aria-label="{{ filter.label | escape }}">
              <span>{{ filter.label | escape }}</span>
              <span class="faq__icon" aria-hidden="true"></span>
            </summary>

            <div id="Facet-{{ forloop.index }}-{{ section_id }}" class="facet__panel facets__display-vertical">
              {%- case filter.type -%}
                {%- when 'boolean', 'list' -%}
                  {%- if has_swatches -%}
                    <div class="swatch-list">
                      {%- for value in filter.values -%}
                        {%- liquid
                          assign input_id = 'Filter-' | append: filter.param_name | escape | append: '-' | append: forloop.index
                          assign swatch_bg = blank
                          if value.swatch.image
                            assign swatch_bg = 'url(' | append: value.swatch.image | image_url: width: 50 | append: ') center/cover'
                          elsif value.swatch.color
                            assign swatch_bg = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                          endif
                          if swatch_bg == blank
                            capture swatch_bg
                              render 'dews-color-hex', name: value.label
                            endcapture
                            assign swatch_bg = swatch_bg | strip
                          endif
                          if swatch_bg == blank
                            assign swatch_bg = 'var(--bone-deep)'
                          endif
                        -%}
                        <label
                          class="swatch-opt{% if value.active %} is-active{% endif %}"
                          style="background: {{ swatch_bg }};"
                          title="{{ value.label | escape }}"
                          aria-label="{{ value.label | escape }}"
                        >
                          <input
                            class="swatch-opt__input"
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            id="{{ input_id }}"
                            {% if value.active %}checked{% endif %}
                            {% if value.count == 0 and value.active == false %}disabled{% endif %}
                          >
                          <span class="swatch-opt__ring" aria-hidden="true"></span>
                        </label>
                      {%- endfor -%}
                    </div>
                  {%- else -%}
                    <fieldset class="facets-wrap parent-wrap">
                      <legend class="visually-hidden">{{ filter.label | escape }}</legend>
                      <ul class="facets__list list-unstyled" role="list">
                        {%- for value in filter.values -%}
                          {%- liquid
                            assign input_id = 'Filter-' | append: filter.param_name | escape | append: '-' | append: forloop.index
                            assign is_disabled = false
                            if value.count == 0 and value.active == false
                              assign is_disabled = true
                            endif
                          -%}
                          <li class="facets__item">
                            <label for="{{ input_id }}" class="check{% if is_disabled %} disabled{% endif %}">
                              <input
                                class="check__input"
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                id="{{ input_id }}"
                                {% if value.active %}checked{% endif %}
                                {% if is_disabled %}disabled{% endif %}
                              >
                              <span class="check__box" aria-hidden="true"></span>
                              <span class="check__text">{{- value.label | escape -}}</span>
                              <span class="check__count">{{- value.count -}}</span>
                            </label>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </fieldset>
                  {%- endif -%}

                {%- when 'price_range' -%}
                  <price-range class="facets__price price-fields">
                    <label class="sr-only" for="Filter-{{ filter.label | escape }}-GTE">{{ 'products.facets.from' | t }}</label>
                    <input
                      class="price-fields__input"
                      name="{{ filter.min_value.param_name }}"
                      id="Filter-{{ filter.label | escape }}-GTE"
                      {%- if filter.min_value.value -%} value="{{ filter.min_value.value | money_without_currency }}" {%- endif -%}
                      type="text"
                      inputmode="decimal"
                      placeholder="{{ cart.currency.symbol }}0"
                      data-pattern="\d| |,|\."
                      data-min="0"
                      data-max="{{ filter.range_max | money_without_currency }}"
                      aria-label="{{ 'products.facets.from' | t }}"
                    >
                    <span aria-hidden="true">—</span>
                    <label class="sr-only" for="Filter-{{ filter.label | escape }}-LTE">{{ 'products.facets.to' | t }}</label>
                    <input
                      class="price-fields__input"
                      name="{{ filter.max_value.param_name }}"
                      id="Filter-{{ filter.label | escape }}-LTE"
                      {%- if filter.max_value.value -%} value="{{ filter.max_value.value | money_without_currency }}" {%- endif -%}
                      type="text"
                      inputmode="decimal"
                      placeholder="{{ cart.currency.symbol }}{{ filter.range_max | money_without_currency }}"
                      data-pattern="\d| |,|\."
                      data-min="0"
                      data-max="{{ filter.range_max | money_without_currency }}"
                      aria-label="{{ 'products.facets.to' | t }}"
                    >
                  </price-range>
              {%- endcase -%}
            </div>
          </details>
        {%- endfor -%}
      </div>
    </form>
  </facet-filters-form>
{%- endif -%}
