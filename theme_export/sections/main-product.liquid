{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
  assign dims = product.metafields.custom.dimensions.value
  assign specs = product.metafields.custom.specifications.value
  assign materials = product.metafields.custom.materials_care.value
  assign delivery = product.metafields.custom.delivery_returns.value
  assign delivery_content = delivery
  if delivery_content == blank and section.settings.delivery_page != blank
    assign delivery_content = section.settings.delivery_page.content
  endif
  assign lead = product.metafields.custom.short_description.value
  if lead == blank
    assign lead = product.description | strip_html | truncate: 160
  endif
  assign current_price = current_variant.price
  assign compare_price = current_variant.compare_at_price
  if compare_price == blank or compare_price <= current_price
    assign compare_price = nil
  endif
  assign option_swatches = product.metafields.custom.option_swatches.value
-%}

{{ 'component-dews-product.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{%- unless product.has_only_default_variant -%}
  {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
  {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
  {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
{%- endunless -%}

<product-info
  id="MainProduct-{{ section.id }}"
  data-section="{{ section.id }}"
  data-product-id="{{ product.id }}"
  data-update-url="true"
  data-url="{{ product.url }}"
>
  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'dews-pdp.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'dews-wishlist-pdp.js' | asset_url }}" defer="defer"></script>

  <product-component view-event-payload="{{ product | standard_event_data: 'view', context: 'page' | escape }}">
    <div class="page-head">
      <div class="container">
        <nav aria-label="Breadcrumb">
          <ol class="breadcrumb">
            <li><a href="{{ routes.root_url }}">Home</a></li>
            {%- if collection -%}
              <li><a href="{{ collection.url }}">{{ collection.title | escape }}</a></li>
            {%- else -%}
              <li><a href="{{ routes.all_products_collection_url }}">Collections</a></li>
            {%- endif -%}
            <li><span aria-current="page">{{ product.title | escape }}</span></li>
          </ol>
        </nav>
      </div>
    </div>

    <section class="section section--tight" aria-labelledby="p-title">
      <div class="container">
        <div class="pdp">

          {%- comment -%} ---------- gallery ---------- {%- endcomment -%}
          <div class="gallery" id="gallery">
            <div class="gallery__thumbs" role="tablist" aria-label="Product images">
              {%- for media in product.media -%}
                {%- liquid
                  if media.media_type == 'image'
                    assign thumb_img = media | image_url: width: 180
                    assign full_img = media | image_url: width: 1200
                  else
                    assign thumb_img = media.preview_image | image_url: width: 180
                    assign full_img = media.preview_image | image_url: width: 1200
                  endif
                -%}
                <button
                  class="gallery__thumb{% if forloop.first %} is-active{% endif %}"
                  role="tab"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  data-full="{{ full_img }}"
                  data-media-id="{{ media.id }}"
                  aria-label="View image {{ forloop.index }}"
                >
                  <img src="{{ thumb_img }}" alt="{{ media.alt | escape }}" width="86" height="86" loading="lazy">
                </button>
              {%- endfor -%}
            </div>

            <div class="gallery__main" id="galleryMain">
              <img
                id="galleryImg"
                src="{{ product.featured_media | image_url: width: 1200 }}"
                alt="{{ product.featured_media.alt | default: product.title | escape }}"
                width="900"
                height="900"
                fetchpriority="high"
              >
              <span class="gallery__hint">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3M11 8.5v5M8.5 11h5" stroke-linecap="round"/></svg>
                Click to zoom
              </span>
            </div>
          </div>

          {%- comment -%} ---------- info ---------- {%- endcomment -%}
          <div class="pdp__info">
            <p class="eyebrow">
              <i class="dew" aria-hidden="true"></i>
              {%- if collection -%}
                <a href="{{ collection.url }}">{{ collection.title | escape }}</a>
              {%- elsif product.collections.size > 0 -%}
                <a href="{{ product.collections.first.url }}">{{ product.collections.first.title | escape }}</a>
              {%- else -%}
                {{ product.vendor | escape }}
              {%- endif -%}
            </p>
            <h1 id="p-title">{{ product.title | escape }}</h1>

            {%- comment -%} rating (app block, e.g. Judge.me preview badge) {%- endcomment -%}
            {%- if section.settings.show_rating -%}
              <div class="pdp__rating">
                {%- for block in section.blocks -%}
                  {%- if block.type == '@app' -%}
                    {% render block %}
                  {%- endif -%}
                {%- endfor -%}
              </div>
            {%- endif -%}

            {%- comment -%} price (id is required by product-info.js for variant updates) {%- endcomment -%}
            <div id="price-{{ section.id }}" class="pdp__price" role="status">
              <span class="price">{{ current_price | money }}</span>
              {%- if compare_price -%}
                <span class="price--was">{{ compare_price | money }}</span>
                <span class="price--save">Save {{ compare_price | minus: current_price | money }}</span>
              {%- endif -%}
            </div>

            {%- comment -%} stock {%- endcomment -%}
            <div id="Inventory-{{ section.id }}" class="no-js-hidden">
              {%- if current_variant.available -%}
                {%- if current_variant.inventory_management == 'shopify' and current_variant.inventory_quantity > 0 and current_variant.inventory_quantity <= section.settings.inventory_threshold -%}
                  <p class="pdp__stock pdp__stock--low"><i aria-hidden="true"></i> {{ 'products.product.inventory_low_stock_show_count' | t: quantity: current_variant.inventory_quantity }}</p>
                {%- else -%}
                  <p class="pdp__stock"><i aria-hidden="true"></i> {{ 'products.product.inventory_in_stock' | t }}</p>
                {%- endif -%}
              {%- else -%}
                <p class="pdp__stock pdp__stock--out"><i aria-hidden="true"></i> {{ 'products.product.sold_out' | t }}</p>
              {%- endif -%}
            </div>

            {%- if lead != blank -%}
              <p class="pdp__lead">{{ lead }}</p>
            {%- endif -%}

            {%- comment -%} variants {%- endcomment -%}
            {%- unless product.has_only_default_variant -%}
              <variant-selects
                id="variant-selects-{{ section.id }}"
                data-section="{{ section.id }}"
                data-product-handle="{{ product.handle }}"
                data-product-title="{{ product.title | escape }}"
                data-product-id="{{ product.id }}"
                data-currency-code="{{ cart.currency.iso_code }}"
                {% # theme-check-disable %}
                data-selected-price-amount="{{ current_variant.price | default: 0 | money_amount | escape }}"
                {% # theme-check-enable %}
              >
                {%- for option in product.options_with_values -%}
                  {%- liquid
                    assign is_swatch = false
                    assign swatch_map = blank
                    if option_swatches != blank
                      assign swatch_map = option_swatches[option.name]
                      if swatch_map != blank
                        assign is_swatch = true
                      endif
                    endif
                    assign native_swatch_count = option.values | map: 'swatch' | compact | size
                    if native_swatch_count > 0
                      assign is_swatch = true
                    endif
                  -%}
                  <fieldset class="variant product-form__input">
                    <legend class="variant__label">
                      <span>{{ option.name }}</span>
                      <b data-selected-value>{{ option.selected_value }}</b>
                    </legend>
                    <div class="opt-list" role="group" aria-label="{{ option.name }}">
                      {%- for value in option.values -%}
                        {%- liquid
                          assign option_disabled = false
                          unless value.available
                            assign option_disabled = true
                          endunless
                          assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0
                          assign raw_value = value.name | default: value
                          assign swatch_color = blank
                          if swatch_map != blank and is_swatch
                            assign swatch_color = swatch_map[raw_value]
                          endif
                        -%}
                        <input
                          type="radio"
                          id="{{ input_id }}"
                          name="options[{{ option.name | escape }}]"
                          value="{{ raw_value | escape }}"
                          form="{{ product_form_id }}"
                          {% if value.selected %}checked{% endif %}
                          {% if option_disabled %}class="disabled"{% endif %}
                          data-option-value-id="{{ value.id }}"
                          data-option-name="{{ option.name | escape }}"
                          data-product-url="{{ value.product_url }}"
                        >
                        {%- if is_swatch -%}
                          <label
                            for="{{ input_id }}"
                            class="swatch-btn"
                            style="background:{% if swatch_color != blank %}{{ swatch_color }}{% elsif value.swatch.color %}rgb({{ value.swatch.color.rgb }}){% elsif value.swatch.image %}url({{ value.swatch.image | image_url: width: 50 }}) center/cover{% else %}var(--bone-deep){% endif %};"
                            aria-label="{{ option.name }}: {{ raw_value | escape }}"
                          ></label>
                        {%- else -%}
                          <label for="{{ input_id }}" class="opt">{{ raw_value | escape }}</label>
                        {%- endif -%}
                      {%- endfor -%}
                    </div>
                    {%- if option.name | downcase contains 'fabric' -%}
                      <p class="swatch-note">
                        {%- if section.settings.swatch_link_text != blank -%}
                          <a href="{{ section.settings.swatch_link_url | default: '#' }}">{{ section.settings.swatch_link_text }}</a>
                        {%- endif -%}
                        {%- if section.settings.swatch_note != blank -%}
                          — {{ section.settings.swatch_note }}
                        {%- endif -%}
                      </p>
                    {%- endif -%}
                  </fieldset>
                {%- endfor -%}

                <script type="application/json" data-selected-variant>
                  {{ current_variant | json }}
                </script>
              </variant-selects>
            {%- endunless -%}

            {%- comment -%} buy row {%- endcomment -%}
            <product-form class="product-form" data-section-id="{{ section.id }}" data-hide-errors="false">
              <div class="product-form__error-message-wrapper" role="alert" hidden>
                <span class="product-form__error-message"></span>
              </div>

              {%- form 'product',
                product,
                id: product_form_id,
                class: 'form',
                novalidate: 'novalidate',
                data-type: 'add-to-cart-form'
              -%}
                <input
                  type="hidden"
                  name="id"
                  value="{{ current_variant.id }}"
                  class="product-variant-id"
                  {% if current_variant.available == false %}disabled{% endif %}
                >

                <div class="buy" id="buyRow">
                  <div id="Quantity-Form-{{ section.id }}" class="product-form__quantity">
                    <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.product.quantity.label' | t }}</label>
                    <quantity-input class="qty">
                      <button class="quantity__button" name="minus" type="button" aria-label="{{ 'products.product.quantity.decrease' | t: product: product.title | escape }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M5 12h14" stroke-linecap="round"/></svg>
                      </button>
                      <input
                        class="quantity__input"
                        type="number"
                        name="quantity"
                        id="Quantity-{{ section.id }}"
                        data-cart-quantity="{{ cart | item_count_for_variant: current_variant.id }}"
                        data-min="{{ current_variant.quantity_rule.min }}"
                        min="{{ current_variant.quantity_rule.min }}"
                        {% if current_variant.quantity_rule.max != null %}
                          data-max="{{ current_variant.quantity_rule.max }}"
                          max="{{ current_variant.quantity_rule.max }}"
                        {% endif %}
                        step="{{ current_variant.quantity_rule.increment }}"
                        value="{{ current_variant.quantity_rule.min }}"
                        form="{{ product_form_id }}"
                      >
                      <button class="quantity__button" name="plus" type="button" aria-label="{{ 'products.product.quantity.increase' | t: product: product.title | escape }}">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke-linecap="round"/></svg>
                      </button>
                    </quantity-input>
                  </div>

                  <button
                    id="ProductSubmitButton-{{ section.id }}"
                    type="submit"
                    name="add"
                    class="btn product-form__submit"
                    {% if current_variant.available == false %}disabled{% endif %}
                  >
                    <span>
                      {%- if current_variant.available -%}
                        {{ 'products.product.add_to_cart' | t }}
                      {%- else -%}
                        {{ 'products.product.sold_out' | t }}
                      {%- endif -%}
                    </span>
                    <div class="loading-overlay__spinner loading__spinner hidden">
                      <svg aria-hidden="true" focusable="false" class="spinner" viewBox="0 0 66 66" xmlns="http://www.w3.org/2000/svg">
                        <circle class="path" fill="none" stroke-width="6" cx="33" cy="33" r="30"></circle>
                      </svg>
                    </div>
                  </button>

                  {%- comment -%} Wishlist Hero app button (rendered directly so the
                     "added to wishlist" popup has full product data). {%- endcomment -%}
                  <div class="buy__wishlist" data-wishlist-slot aria-label="Wishlist">
                    {%- render 'wishlisthero-product-page', product: product, variant: current_variant -%}
                  </div>
                </div>

                {%- comment -%} Buy now — Shopify dynamic checkout (express). {%- endcomment -%}
                <div class="buy-now">
                  {{ form | payment_button }}
                </div>
              {%- endform -%}
            </product-form>

            {%- if section.settings.pay_note != blank -%}
              <p class="pdp__pay">{{ section.settings.pay_note }}</p>
            {%- endif -%}

            {%- comment -%} trust {%- endcomment -%}
            {%- if section.settings.show_trust -%}
              <div class="pdp__trust">
              <div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M2 7h11v9H2z"/><path d="M13 10h5l3 3v3h-8z"/><circle cx="7" cy="18" r="1.5"/><circle cx="17.5" cy="18" r="1.5"/></svg>
                <span><b>{{ section.settings.trust_1_title }}</b>{{ section.settings.trust_1_text }}</span>
              </div>
              <div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5.3M20 12a8 8 0 0 1-14 5.3" stroke-linecap="round"/><path d="M18 3v4h-4M6 21v-4h4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span><b>{{ section.settings.trust_2_title }}</b>{{ section.settings.trust_2_text }}</span>
              </div>
              <div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.4 8-8 9-4.6-1-8-4-8-9V6l8-3z"/><path d="M9 12l2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span><b>{{ section.settings.trust_3_title }}</b>{{ section.settings.trust_3_text }}</span>
              </div>
              <div>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><rect x="5" y="11" width="14" height="9" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                <span><b>{{ section.settings.trust_4_title }}</b>{{ section.settings.trust_4_text }}</span>
              </div>
            </div>
            {%- endif -%}

            {%- comment -%} accordions (native <details>, open/close works without JS) {%- endcomment -%}
            <div class="faq faq--flush">
              {%- if product.description != blank -%}
                <details class="faq__item" open>
                  <summary class="faq__q">
                    <h2>{{ section.settings.acc_1_title }}</h2>
                    <span class="faq__icon" aria-hidden="true"></span>
                  </summary>
                  <div class="faq__a">
                    <div class="acc-body">{{ product.description }}</div>
                  </div>
                </details>
              {%- endif -%}

              {%- if specs != blank or dims != blank -%}
                <details class="faq__item">
                  <summary class="faq__q">
                    <h2>{{ section.settings.acc_2_title }}</h2>
                    <span class="faq__icon" aria-hidden="true"></span>
                  </summary>
                  <div class="faq__a">
                    <div class="acc-body">
                      {%- if specs != blank -%}
                        <table class="spec">
                          <caption class="sr-only">{{ section.settings.acc_2_title }}</caption>
                          <tbody>
                            {%- for row in specs -%}
                              <tr><th scope="row">{{ row.label }}</th><td>{{ row.value }}</td></tr>
                            {%- endfor -%}
                          </tbody>
                        </table>
                      {%- elsif dims != blank -%}
                        <table class="spec">
                          <caption class="sr-only">{{ section.settings.acc_2_title }}</caption>
                          <tbody>
                            <tr><th scope="row">Overall dimensions</th><td>{{ dims }}</td></tr>
                          </tbody>
                        </table>
                      {%- endif -%}
                    </div>
                  </div>
                </details>
              {%- endif -%}

              {%- if materials != blank -%}
                <details class="faq__item">
                  <summary class="faq__q">
                    <h2>{{ section.settings.acc_3_title }}</h2>
                    <span class="faq__icon" aria-hidden="true"></span>
                  </summary>
                  <div class="faq__a">
                    <div class="acc-body">{{ materials }}</div>
                  </div>
                </details>
              {%- endif -%}

              {%- if delivery_content != blank -%}
                <details class="faq__item">
                  <summary class="faq__q">
                    <h2>{{ section.settings.acc_4_title }}</h2>
                    <span class="faq__icon" aria-hidden="true"></span>
                  </summary>
                  <div class="faq__a">
                    <div class="acc-body">{{ delivery_content }}</div>
                  </div>
                </details>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </section>

    {%- comment -%} sticky add-to-cart {%- endcomment -%}
    {%- if section.settings.show_sticky_atc -%}
      <div class="sticky-atc" id="stickyAtc">
        <div class="sticky-atc__media">
          <img src="{{ product.featured_media | image_url: width: 100 }}" alt="{{ product.title | escape }}" width="48" height="48" loading="lazy">
        </div>
        <div class="sticky-atc__info">
          <b>{{ product.title | escape }}</b>
          <span data-sticky-price>{{ current_price | money }}{% if compare_price %} <span style="text-decoration:line-through;color:var(--muted-2)">{{ compare_price | money }}</span>{% endif %}</span>
        </div>
        <button class="btn" type="button" data-sticky-submit>{{ 'products.product.add_to_cart' | t }}</button>
      </div>
    {%- endif -%}
  </product-component>

  <script type="application/ld+json">
    {{ product | structured_data }}
  </script>
</product-info>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "text",
      "id": "pay_note",
      "label": "Payment note",
      "default": "or 4 interest-free payments — payment provider to be confirmed"
    },
    {
      "type": "range",
      "id": "inventory_threshold",
      "label": "Low stock threshold",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 10
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust",
      "label": "Show trust badges",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sticky_atc",
      "label": "Show sticky add-to-cart bar",
      "default": true
    },
    {
      "type": "header",
      "content": "Trust badges"
    },
    {
      "type": "text",
      "id": "trust_1_title",
      "label": "Trust 1 — title",
      "default": "Free white-glove delivery"
    },
    {
      "type": "text",
      "id": "trust_1_text",
      "label": "Trust 1 — text",
      "default": "Placed in your room, assembled, packaging taken away."
    },
    {
      "type": "text",
      "id": "trust_2_title",
      "label": "Trust 2 — title",
      "default": "30-day returns"
    },
    {
      "type": "text",
      "id": "trust_2_text",
      "label": "Trust 2 — text",
      "default": "Live with it a month. We collect if it isn't right."
    },
    {
      "type": "text",
      "id": "trust_3_title",
      "label": "Trust 3 — title",
      "default": "1-year warranty"
    },
    {
      "type": "text",
      "id": "trust_3_text",
      "label": "Trust 3 — text",
      "default": "Structural cover against manufacturing defects."
    },
    {
      "type": "text",
      "id": "trust_4_title",
      "label": "Trust 4 — title",
      "default": "Secure checkout"
    },
    {
      "type": "text",
      "id": "trust_4_text",
      "label": "Trust 4 — text",
      "default": "Shop Pay, PayPal, Apple Pay and all major cards."
    },
    {
      "type": "header",
      "content": "Fabric swatch note"
    },
    {
      "type": "text",
      "id": "swatch_link_text",
      "label": "Link text",
      "default": "Order free fabric swatches"
    },
    {
      "type": "url",
      "id": "swatch_link_url",
      "label": "Link URL"
    },
    {
      "type": "text",
      "id": "swatch_note",
      "label": "Suffix text",
      "default": "match the finish at home first."
    },
    {
      "type": "header",
      "content": "Accordion headings"
    },
    {
      "type": "text",
      "id": "acc_1_title",
      "label": "Accordion 1 — title",
      "default": "Description"
    },
    {
      "type": "text",
      "id": "acc_2_title",
      "label": "Accordion 2 — title",
      "default": "Dimensions & specifications"
    },
    {
      "type": "text",
      "id": "acc_3_title",
      "label": "Accordion 3 — title",
      "default": "Materials & care"
    },
    {
      "type": "text",
      "id": "acc_4_title",
      "label": "Accordion 4 — title",
      "default": "Delivery & returns"
    },
    {
      "type": "page",
      "id": "delivery_page",
      "label": "Delivery & returns — page",
      "info": "Used when the product has no custom.delivery_returns metafield. Useful for a store-wide shipping/returns policy."
    }
  ],
  "blocks": [
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
