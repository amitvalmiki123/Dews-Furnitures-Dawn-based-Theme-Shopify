{{ 'dews-pages.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Dew's Furniture — premium pillar cards (Our Craft / Sustainability).
  Each block = one card: icon + heading + short text, in a 4-up grid.
{%- endcomment -%}

<section class="craft-features bg-{{ section.settings.bg_color }}">
  <div class="container">
    {%- if section.settings.heading != blank -%}
      <div class="section-head">
        <div class="section-head__text">
          {%- if section.settings.eyebrow != blank -%}
            <p class="eyebrow"><i class="dew" aria-hidden="true"></i> {{ section.settings.eyebrow }}</p>
          {%- endif -%}
          <h2>{{ section.settings.heading }}</h2>
        </div>
      </div>
    {%- endif -%}

    <div class="craft-features__grid">
      {%- for block in section.blocks -%}
        <div class="feature-item" {{ block.shopify_attributes }}>
          {%- if block.settings.icon_image != blank -%}
            <img src="{{ block.settings.icon_image | image_url: width: 120 }}" alt="" class="feature-item__icon" loading="lazy">
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3>{{ block.settings.title }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p>{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Custom Craft Features",
  "max_blocks": 4,
  "settings": [
    {
      "type": "select",
      "id": "bg_color",
      "label": "Background color",
      "options": [
        { "value": "white", "label": "Paper" },
        { "value": "bone", "label": "Bone" }
      ],
      "default": "white"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why it lasts"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Crafted to endure"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image (PNG/SVG)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Short description about this specific feature."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Craft Features",
      "blocks": [
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" },
        { "type": "feature" }
      ]
    }
  ]
}
{% endschema %}
