{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'dews-collection.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- comment -%}
  Dew's Furniture — search page (collection.html reference)
  Reuses the collection layout: breadcrumb + single-column chero hero (with the
  search form) above the "shop" layout (sticky filter rail + results grid of
  dews-product-card + reference pager). Powered by Shopify facets.
{%- endcomment -%}

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
-%}

<div class="page-head">
  <div class="container">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb">
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li><span aria-current="page">Search</span></li>
      </ol>
    </nav>
  </div>
</div>

<section class="section collection-banner search-banner" aria-labelledby="search-title-{{ section.id }}">
  <div class="container">
    <div class="chero chero--single">
      <div class="chero__text">
        <p class="eyebrow"><i class="dew" aria-hidden="true"></i> Search</p>
        <h1 id="search-title-{{ section.id }}">
          {%- if search.performed -%}
            Search results
          {%- else -%}
            Find your perfect piece
          {%- endif -%}
        </h1>

        {%- if search.performed -%}
          <div class="chero__desc">
            <p>
              {%- if search.results_count > 0 -%}
                {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for “{{ terms }}”
              {%- else -%}
                No results for “{{ terms }}”. Try a different search.
              {%- endif -%}
            </p>
          </div>
        {%- else -%}
          <div class="chero__desc">
            <p>Search sofas, beds, armchairs, cane and more.</p>
          </div>
        {%- endif -%}

        <div class="search-page__form">
          {%- if settings.predictive_search_enabled -%}
            <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
          {%- endif -%}
          <main-search>
            <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__search">
              <div class="search-page__field">
                <svg aria-hidden="true"><use href="#i-search"/></svg>
                <input
                  class="search-page__input"
                  id="Search-In-Template"
                  type="search"
                  name="q"
                  value="{{ search.terms | escape }}"
                  placeholder="Search products…"
                  {%- if settings.predictive_search_enabled -%}
                    role="combobox"
                    aria-expanded="false"
                    aria-owns="predictive-search-results"
                    aria-controls="predictive-search-results"
                    aria-haspopup="listbox"
                    aria-autocomplete="list"
                    autocorrect="off"
                    autocomplete="off"
                    autocapitalize="off"
                    spellcheck="false"
                  {%- endif -%}
                >
                <input name="options[prefix]" type="hidden" value="last">

                {%- if settings.predictive_search_enabled -%}
                  <div class="predictive-search predictive-search--search-template" tabindex="-1" data-predictive-search>
                    {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
                  </div>
                  <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
                {%- endif -%}

                {%- if search.terms != blank -%}
                  <button type="reset" class="search-page__reset" aria-label="{{ 'general.search.reset' | t }}">
                    <svg aria-hidden="true"><use href="#i-close"/></svg>
                  </button>
                {%- endif -%}
                <button type="submit" class="search-page__submit btn" aria-label="{{ 'general.search.search' | t }}">Search</button>
              </div>
            </form>
          </main-search>
          {%- if settings.predictive_search_enabled -%}
            </predictive-search>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{%- if search.performed -%}
  {% paginate search.results by 24 %}
    <section class="section search-page">
      <div class="container">
        <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          {% render 'facets',
            results: search,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: 'vertical',
            paginate: paginate
          %}
        {%- endif -%}

        <div class="shop">
          {%- if section.settings.enable_filtering and search.filters.size > 0 -%}
            <aside class="filters filters--rail" aria-label="{{ 'products.facets.filter_by_label' | t }}" id="main-search-filters" data-id="{{ section.id }}">
              {% render 'facets-rail',
                results: search,
                enable_filtering: section.settings.enable_filtering,
                filter_type: 'vertical',
                section_id: section.id
              %}
            </aside>
          {%- endif -%}

          <div class="results" id="ProductGridContainer" {% if settings.animations_reveal_on_scroll %}data-cascade{% endif %}>
            {%- if search.results.size == 0 -%}
              <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
                <div class="loading-overlay gradient"></div>
                <div class="empty">
                  <svg aria-hidden="true"><use href="#i-search"/></svg>
                  <h3>{{ 'sections.collection_template.empty' | t }}</h3>
                  <p>{{ 'sections.collection_template.use_fewer_filters_html' | t: link: search.url, class: 'underlined-link link' }}</p>
                </div>
              </div>
            {%- else -%}
              <div class="collection">
                <div class="loading-overlay gradient"></div>

                {%- comment -%} active filter chips {%- endcomment -%}
                <div class="chips active-facets active-facets-desktop" id="activeChips">
                  {%- for filter in search.filters -%}
                    {%- for value in filter.active_values -%}
                      <facet-remove>
                        <a href="{{ value.url_to_remove }}" class="chip">
                          {{ filter.label }}: {{ value.label }}
                          <span class="chip__x"><svg aria-hidden="true"><use href="#i-close"/></svg></span>
                        </a>
                      </facet-remove>
                    {%- endfor -%}
                    {%- if filter.type == 'price_range' -%}
                      {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                        <facet-remove>
                          <a href="{{ filter.url_to_remove }}" class="chip">
                            {{ filter.label }}:
                            {%- if filter.min_value.value -%}{{ filter.min_value.value | money_without_currency }}{%- else -%}0{%- endif -%}–
                            {%- if filter.max_value.value -%}{{ filter.max_value.value | money_without_currency }}{%- else -%}{{ filter.range_max | money_without_currency }}{%- endif -%}
                            <span class="chip__x"><svg aria-hidden="true"><use href="#i-close"/></svg></span>
                          </a>
                        </facet-remove>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                <div class="grid-products" id="product-grid" data-id="{{ section.id }}">
                  {%- for item in search.results -%}
                    {%- case item.object_type -%}
                      {%- when 'product' -%}
                        {% render 'dews-product-card', product: item, index: forloop.index %}
                      {%- when 'article' -%}
                        {% render 'article-card',
                          article: item,
                          show_image: true,
                          show_date: section.settings.article_show_date,
                          show_author: section.settings.article_show_author,
                          show_badge: true,
                          media_aspect_ratio: 1,
                          lazy_load: true
                        %}
                      {%- when 'page' -%}
                        <a class="product search-page__page-card" href="{{ item.url }}">
                          <span class="search-page__page-badge">{{ 'templates.search.page' | t }}</span>
                          <h3>{{ item.title | truncate: 50 | escape }}</h3>
                        </a>
                    {%- endcase -%}
                  {%- endfor -%}
                </div>

                {%- if paginate.pages > 1 -%}
                  {% render 'dews-pagination', paginate: paginate %}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </section>
  {% endpaginate %}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section search-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_filtering.label",
      "info": "t:sections.main-collection-product-grid.settings.enable_filtering.info"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "t:sections.main-collection-product-grid.settings.enable_sorting.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__2.content"
    },
    {
      "type": "checkbox",
      "id": "article_show_date",
      "default": true,
      "label": "t:sections.main-search.settings.article_show_date.label"
    },
    {
      "type": "checkbox",
      "id": "article_show_author",
      "default": false,
      "label": "t:sections.main-search.settings.article_show_author.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.main-search.presets.name"
    }
  ]
}
{% endschema %}
