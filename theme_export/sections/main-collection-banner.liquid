{%- comment -%}
  Dew's Furniture — collection hero
  Centered eyebrow + display title + description on a bone background,
  matching the homepage hero / section-head design language.
{%- endcomment -%}

<section class="collection-hero" aria-labelledby="collection-title-{{ section.id }}">
  <div class="container">
    <div class="section-head section-head--center">
      <div class="section-head__text">
        {%- if section.settings.show_eyebrow and section.settings.eyebrow != blank -%}
          <p class="eyebrow"><i class="dew" aria-hidden="true"></i> {{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 id="collection-title-{{ section.id }}" class="collection-hero__title">{{ collection.title | escape }}</h1>
        {%- if section.settings.show_collection_description and collection.description != blank -%}
          <div class="collection-hero__desc rte">{{ collection.description }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_eyebrow",
      "default": true,
      "label": "Show eyebrow"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Shop the edit",
      "label": "Eyebrow text"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "Show collection description"
    }
  ],
  "presets": [
    {
      "name": "Collection banner"
    }
  ]
}
{% endschema %}
