{{ 'dews-collection.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Dew's Furniture — collection banner
  Breadcrumb + two-column hero (text with meta badges + media image),
  matching collection.html (.page-head + .chero).
{%- endcomment -%}

{%- assign hero_image = collection.image -%}
{%- if hero_image == blank and section.settings.image != blank -%}
  {%- assign hero_image = section.settings.image -%}
{%- endif -%}

<div class="page-head">
  <div class="container">
    <nav aria-label="Breadcrumb">
      <ol class="breadcrumb">
        <li><a href="{{ routes.root_url }}">Home</a></li>
        <li><a href="{{ routes.all_products_collection_url }}">Collections</a></li>
        <li><span aria-current="page">{{ collection.title | escape }}</span></li>
      </ol>
    </nav>
  </div>
</div>

<section class="section collection-banner" aria-labelledby="coll-title-{{ section.id }}">
  <div class="container">
    <div class="chero{% if hero_image == blank %} chero--single{% endif %}">
      <div class="chero__text">
        {%- if section.settings.eyebrow != blank -%}
          <p class="eyebrow"><i class="dew" aria-hidden="true"></i> {{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h1 id="coll-title-{{ section.id }}">{{ collection.title | escape }}</h1>

        {%- if section.settings.show_collection_description and collection.description != blank -%}
          <div class="chero__desc">{{ collection.description }}</div>
        {%- elsif section.settings.description != blank -%}
          <p>{{ section.settings.description }}</p>
        {%- endif -%}

        {%- if section.settings.show_meta -%}
          <div class="chero__meta">
            {%- if section.settings.meta_1_text != blank -%}
              <div><svg aria-hidden="true"><use href="#i-hammer"/></svg> {{ section.settings.meta_1_text }}</div>
            {%- endif -%}
            {%- if section.settings.meta_2_text != blank -%}
              <div><svg aria-hidden="true"><use href="#i-truck"/></svg> {{ section.settings.meta_2_text }}</div>
            {%- endif -%}
            {%- if section.settings.meta_3_text != blank -%}
              <div><svg aria-hidden="true"><use href="#i-rotate"/></svg> {{ section.settings.meta_3_text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if hero_image != blank -%}
        <div class="chero__media">
          <img
            src="{{ hero_image | image_url: width: 1200 }}"
            alt="{{ hero_image.alt | default: collection.title | escape }}"
            width="1000"
            height="625"
            loading="eager"
            decoding="async"
          >
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "class": "section collection-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "default": "Collection",
      "label": "Eyebrow text"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "Show collection description"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Fallback description",
      "info": "Shown when the collection has no description."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Fallback image shown when the collection has no image."
    },
    {
      "type": "checkbox",
      "id": "show_meta",
      "default": true,
      "label": "Show meta badges"
    },
    {
      "type": "text",
      "id": "meta_1_text",
      "default": "Hand-woven cane",
      "label": "Meta badge 1"
    },
    {
      "type": "text",
      "id": "meta_2_text",
      "default": "Free delivery over $999",
      "label": "Meta badge 2"
    },
    {
      "type": "text",
      "id": "meta_3_text",
      "default": "30-day returns",
      "label": "Meta badge 3"
    }
  ],
  "presets": [
    {
      "name": "Collection banner"
    }
  ]
}
{% endschema %}
