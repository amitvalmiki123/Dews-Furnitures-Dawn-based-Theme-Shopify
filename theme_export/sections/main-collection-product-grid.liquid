{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-facets.css' | asset_url | stylesheet_tag }}
{{ 'dews-collection.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Dew's Furniture — collection product grid (collection.html reference)
  Sticky toolbar (Filters pill + count + sort) above a 2-column "shop" layout:
  a sticky filter rail (left) and the results grid (right). Filters are powered
  by Shopify facets (Search & Discovery) — facets.js hooks are preserved.
{%- endcomment -%}

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <div class="section collection-page">
    <div class="container">
      {%- paginate collection.products by section.settings.products_per_page -%}
        <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          {% render 'facets',
            results: collection,
            enable_filtering: section.settings.enable_filtering,
            enable_sorting: section.settings.enable_sorting,
            filter_type: 'vertical',
            paginate: paginate
          %}
        {%- endif -%}

        <div class="shop">
          {%- if section.settings.enable_filtering -%}
            <aside class="filters filters--rail" aria-label="{{ 'products.facets.filter_by_label' | t }}" id="main-collection-filters" data-id="{{ section.id }}">
              {% render 'facets-rail',
                results: collection,
                enable_filtering: section.settings.enable_filtering,
                filter_type: 'vertical',
                section_id: section.id
              %}
            </aside>
          {%- endif -%}

          <div class="results" id="ProductGridContainer" {% if settings.animations_reveal_on_scroll %}data-cascade{% endif %}>
            {%- if collection.products.size == 0 -%}
              <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
                <div class="loading-overlay gradient"></div>
                <div class="empty">
                  <svg aria-hidden="true"><use href="#i-search"/></svg>
                  <h3>{{ 'sections.collection_template.empty' | t }}</h3>
                  <p>{{ 'sections.collection_template.use_fewer_filters_html' | t: link: collection.url, class: 'underlined-link link' }}</p>
                </div>
              </div>
            {%- else -%}
              <div class="collection">
                <div class="loading-overlay gradient"></div>

                {%- comment -%} active filter chips {%- endcomment -%}
                <div class="chips active-facets active-facets-desktop" id="activeChips">
                  {%- for filter in collection.filters -%}
                    {%- for value in filter.active_values -%}
                      <facet-remove>
                        <a href="{{ value.url_to_remove }}" class="chip">
                          {{ filter.label }}: {{ value.label }}
                          <span class="chip__x"><svg aria-hidden="true"><use href="#i-close"/></svg></span>
                        </a>
                      </facet-remove>
                    {%- endfor -%}
                    {%- if filter.type == 'price_range' -%}
                      {%- if filter.min_value.value != nil or filter.max_value.value != nil -%}
                        <facet-remove>
                          <a href="{{ filter.url_to_remove }}" class="chip">
                            {{ filter.label }}:
                            {%- if filter.min_value.value -%}{{ filter.min_value.value | money_without_currency }}{%- else -%}0{%- endif -%}–
                            {%- if filter.max_value.value -%}{{ filter.max_value.value | money_without_currency }}{%- else -%}{{ filter.range_max | money_without_currency }}{%- endif -%}
                            <span class="chip__x"><svg aria-hidden="true"><use href="#i-close"/></svg></span>
                          </a>
                        </facet-remove>
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}
                </div>

                <div class="grid-products" id="product-grid" data-id="{{ section.id }}">
                  {%- for product in collection.products -%}
                    {% render 'dews-product-card', product: product, index: forloop.index %}
                  {%- endfor -%}
                </div>

                {%- if paginate.pages > 1 -%}
                  {% render 'dews-pagination', paginate: paginate %}
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endpaginate -%}
    </div>
  </div>
</collection-component>

{% schema %}
{
  "name": "Collection product grid",
  "tag": "section",
  "class": "section collection-product-grid-section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 3,
      "max": 36,
      "step": 3,
      "default": 12,
      "label": "Products per page",
      "info": "Multiples of 3 keep the 3-column grid balanced."
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering",
      "info": "Shows the filters you set up in the Search & Discovery app."
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    }
  ],
  "presets": [
    {
      "name": "Collection product grid"
    }
  ]
}
{% endschema %}
