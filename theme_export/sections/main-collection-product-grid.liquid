{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}

{%- comment -%}
  Dew's Furniture — collection product grid
  Clean toolbar (product count + facets + sort) above a 3-column
  .grid-products grid of dews-product-card cards. Keeps the facets.js
  hooks (#FacetFiltersForm, #ProductGridContainer, #ProductCount) so the
  Shopify Search & Discovery filters (Availability, Price, Category, …)
  keep working with AJAX updates.
{%- endcomment -%}

<collection-component
  view-event-payload="{{ collection | standard_event_data: 'view' | escape }}"
  data-collection-id="{{ collection.id }}"
>
  <div class="section collection-page">
    <div class="container">
      {%- paginate collection.products by section.settings.products_per_page -%}
        {{ 'component-facets.css' | asset_url | stylesheet_tag }}
        <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>

        {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
          <aside
            aria-labelledby="verticalTitle"
            class="facets-wrapper collection-toolbar{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}"
            id="main-collection-filters"
            data-id="{{ section.id }}"
          >
            {% render 'facets',
              results: collection,
              enable_filtering: section.settings.enable_filtering,
              enable_sorting: section.settings.enable_sorting,
              filter_type: 'horizontal',
              paginate: paginate
            %}
          </aside>
        {%- endif -%}

        <div
          class="product-grid-container"
          id="ProductGridContainer"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
          {% endif %}
        >
          {%- if collection.products.size == 0 -%}
            <div class="collection collection--empty" id="product-grid" data-id="{{ section.id }}">
              <div class="loading-overlay gradient"></div>
              <div class="section-head section-head--center">
                <div class="section-head__text">
                  <h2 class="title title--primary">{{ 'sections.collection_template.empty' | t }}</h2>
                  <p>
                    {{ 'sections.collection_template.use_fewer_filters_html' | t: link: collection.url, class: 'underlined-link link' }}
                  </p>
                </div>
              </div>
            </div>
          {%- else -%}
            <div class="collection">
              <div class="loading-overlay gradient"></div>
              <div class="grid-products" id="product-grid" data-id="{{ section.id }}">
                {%- for product in collection.products -%}
                  {% render 'dews-product-card', product: product, index: forloop.index %}
                {%- endfor -%}
              </div>

              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate, anchor: '' %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endpaginate -%}
    </div>
  </div>
</collection-component>

{% schema %}
{
  "name": "Collection product grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "min": 3,
      "max": 36,
      "step": 3,
      "default": 12,
      "label": "Products per page",
      "info": "Multiples of 3 keep the 3-column grid balanced."
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering",
      "info": "Shows the filters you set up in the Search & Discovery app."
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    }
  ],
  "presets": [
    {
      "name": "Collection product grid"
    }
  ]
}
{% endschema %}
